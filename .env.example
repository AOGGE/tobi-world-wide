# Required for production (Render sets PORT for you)
PORT=5001
TWW_HOST=0.0.0.0

# PostgreSQL connection string (Render: use the Internal Database URL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# First admin account, created automatically on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# AI tutor and verified AI news search
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: only needed if serving the API from a different origin
# TWW_ALLOWED_ORIGIN=https://your-live-domain.example
