# Required for production
PORT=5001
TWW_HOST=0.0.0.0

# Microsoft SQL Server connection (choose connection string OR the fields below)
SQL_SERVER=your-sql-server.database.windows.net
SQL_DATABASE=your-database
SQL_AUTH=password
SQL_USER=your-database-user
SQL_PASSWORD=replace-with-a-secret

# AI tutor and verified AI news search
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: only needed if serving the API from a different origin
# TWW_ALLOWED_ORIGIN=https://your-live-domain.example
